# Leave empty for same-origin calls (Vite proxies /api in dev, nginx proxies it in the container).
# Set it only when pointing the SPA at a backend on another host.
VITE_API_BASE_URL=

# Dev-server / Playwright proxy target.
BACKEND_ORIGIN=http://localhost:8080

# Playwright
E2E_BASE_URL=http://localhost:5173
